# OCR Fusion Studio - example environment configuration.
# Copy to .env and edit. Every variable is optional; anything omitted falls back
# to the settings file, then to the packaged defaults.
#
# NEVER commit a real .env - it is excluded by .gitignore.

# --- Ollama -----------------------------------------------------------------
OCRFS_OLLAMA_HOST=http://localhost:11434

# --- Stage 1: Qwen2.5-VL ----------------------------------------------------
OCRFS_QWEN_MODEL=qwen2.5vl:3b
OCRFS_QWEN_TEMPERATURE=0.0
OCRFS_QWEN_MAX_TOKENS=4096
# Generous by default: a cold model load on CPU can exceed five minutes.
OCRFS_QWEN_TIMEOUT=600

# --- Stage 2: Unlimited-OCR -------------------------------------------------
# One of: http | transformers | cli | ollama
OCRFS_UNLIMITED_BACKEND=ollama

# backend=ollama - a local substitute model when no GPU runtime is available
OCRFS_UNLIMITED_OLLAMA_MODEL=deepseek-ocr:3b

# backend=http - vLLM / SGLang / unlimited-ocr-server on a GPU host
# OCRFS_UNLIMITED_ENDPOINT=http://gpu-host:30000/v1
# OCRFS_UNLIMITED_API_KEY=

# backend=transformers - requires a CUDA GPU
# OCRFS_UNLIMITED_MODEL_ID=baidu/Unlimited-OCR
# OCRFS_UNLIMITED_DEVICE=cuda

# backend=cli - an external script or binary
# OCRFS_UNLIMITED_EXECUTABLE=python /path/to/Unlimited-OCR/infer.py

# --- Pipeline ---------------------------------------------------------------
# One of: line_vote | prefer_primary | prefer_longest | llm
OCRFS_FUSION_STRATEGY=line_vote
OCRFS_FUSION_MODEL=qwen2.5:1.5b

# --- Documents --------------------------------------------------------------
OCRFS_PDF_DPI=150
# 0 = no limit. Useful during a live demo so a long PDF cannot run away.
OCRFS_MAX_PAGES=0

# --- Interface and privacy --------------------------------------------------
OCRFS_DEVELOPER_MODE=false
OCRFS_PERSIST_DOCUMENTS=false

# Where user settings are stored.
# OCRFS_SETTINGS_PATH=./runtime/settings.json
